	<!-- Compact radio-style roll checkboxes (no OptionsCheckButton label overlap) -->
	<CheckButton name="SmartLoot_RollRadioTemplate" inherits="UICheckButtonTemplate" virtual="true">
		<Size>
			<AbsDimension x="20" y="20"/>
		</Size>
		<HitRectInsets>
			<AbsInset left="0" right="0" top="0" bottom="0"/>
		</HitRectInsets>
	</CheckButton>

	<Frame name="AutorollListItemTemplate" virtual="true" hidden="true">
		<Size>
			<AbsDimension x="320" y="20"/>
		</Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parent_Highlight" file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD" setAllPoints="true" hidden="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<FontString name="$parent_Text" inherits="GameFontNormal" justifyH="LEFT">
					<Size>
						<AbsDimension x="185" y="18"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="18" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parent_X" inherits="UIPanelCloseButton">
				<Size>
					<AbsDimension x="18" y="18"/>
				</Size>
				<Anchors>
					<Anchor point="LEFT">
						<Offset>
							<AbsDimension x="-2" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SmartLoot.AutorollListRemove(self:GetParent());
					</OnClick>
					<OnEnter>
						getglobal(self:GetParent():GetName().."_Highlight"):Show();
					</OnEnter>
					<OnLeave>
						getglobal(self:GetParent():GetName().."_Highlight"):Hide();
					</OnLeave>
				</Scripts>
			</Button>
			<CheckButton name="$parent_Need" inherits="SmartLoot_RollRadioTemplate">
				<Anchors>
					<Anchor point="RIGHT">
						<Offset>
							<AbsDimension x="-78" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SmartLoot.SetAutoroll(self:GetParent(), SmartLoot.Roll.Need);
					</OnClick>
				</Scripts>
			</CheckButton>
			<CheckButton name="$parent_Greed" inherits="SmartLoot_RollRadioTemplate">
				<Anchors>
					<Anchor point="RIGHT">
						<Offset>
							<AbsDimension x="-54" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SmartLoot.SetAutoroll(self:GetParent(), SmartLoot.Roll.Greed);
					</OnClick>
				</Scripts>
			</CheckButton>
			<CheckButton name="$parent_Disenchant" inherits="SmartLoot_RollRadioTemplate">
