				<Scripts>
					<OnClick>
						SmartLoot.SetAutoroll(self:GetParent(), SmartLoot.Roll.Disenchant);
					</OnClick>
				</Scripts>
			</CheckButton>
			<CheckButton name="$parent_Pass" inherits="SmartLoot_RollRadioTemplate">
